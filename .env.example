# Supabase Postgres (Project Settings > Database > Connection string)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Upstash Redis, the rediss:// connection string
REDIS_URL="rediss://default:<password>@<endpoint>.upstash.io:6379"

USE_MOCKS=true # set false when connecting real APIs

# Optional with USE_MOCKS=true. When a key is set the analysis runs on Claude.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# Supabase Storage for PDFs. Without it reports only live in REPORTS_DIR on the worker.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=reports
REPORTS_DIR=/tmp/reports

# Sign-in
AUTH_SECRET= # any long random string, e.g. openssl rand -hex 32
ADMIN_EMAIL=admin@edgelink.test
ADMIN_PASSWORD=
CLIENT_PASSWORD= # shared password for client portal logins
DEMO_MODE=true # shows test account buttons on the sign-in page
DEMO_CLIENT_EMAIL=clinic@smilestudio.test

# App and scheduling
APP_URL=http://localhost:3000
CRON_SECRET=
WORKER_URL= # e.g. https://seo-audit-worker.onrender.com, leave empty to process jobs in the cron route

# Worker
PORT=4000
WORKER_CONCURRENCY=1
PUPPETEER_EXECUTABLE_PATH=

# Real integrations, only read when USE_MOCKS=false
PAGESPEED_API_KEY=
GSC_ACCESS_TOKEN=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
RESEND_API_KEY=
EMAIL_FROM=
